{
  "policy_name": "Cross-Border Trade Finance Gate",
  "version": "2026.4",
  "rules": [
    {
      "metric": "is_sanctioned_port",
      "operator": "equals",
      "value": true,
      "penalty_points": 0,
      "is_knockout": true,
      "error_message": "CRITICAL RISK: Route involves a government-sanctioned port."
    },
    {
      "metric": "is_entity_sanctioned",
      "operator": "equals",
      "value": true,
      "penalty_points": 0,
      "is_knockout": true,
      "error_message": "CRITICAL RISK: EIN or Corporate Name matched an active global enforcement or sanctions watch list."
    },
    {
      "metric": "corporate_registry_status",
      "operator": "not_equals",
      "value": "ACTIVE",
      "penalty_points": 0,
      "is_knockout": true,
      "error_message": "SHELL COMPANY RISK: EIN matched a shadow, shelf, dissolved, or inactive business registration status."
    },
    {
      "metric": "hs_code_risk_tier",
      "operator": "greater_than",
      "value": 2,
      "penalty_points": 25,
      "is_knockout": false,
      "error_message": "TARIFF RISK: HS commodity code belongs to a restricted trade ledger profile."
    }
  ],
  "max_allowed_penalty_points": 30
}
